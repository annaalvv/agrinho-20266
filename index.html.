<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>EcoPitaya - Estufa Sustentável</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:linear-gradient(to bottom,#b9fbc0,#e9f5db);
    color:#1b4332;
}

header{
    background:#2d6a4f;
    color:white;
    text-align:center;
    padding:30px;
}

header h1{
    font-size:40px;
}

header p{
    margin-top:10px;
    font-size:18px;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
    padding:30px 0;
}

.card{
    background:white;
    border-radius:20px;
    padding:25px;
    margin-bottom:30px;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

h2{
    margin-bottom:20px;
    color:#2d6a4f;
}

.controle{
    margin:20px 0;
}

label{
    font-weight:bold;
    display:block;
    margin-bottom:10px;
}

input[type=range]{
    width:100%;
}

.estufa{
    margin-top:30px;
    background:#95d5b2;
    border:6px solid #2d6a4f;
    border-radius:20px;
    padding:30px;
    text-align:center;
    position:relative;
}

#pitaya{
    font-size:120px;
    transition:0.5s;
}

.status{
    margin-top:20px;
    font-size:22px;
    font-weight:bold;
}

.indicadores{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:20px;
    margin-top:20px;
}

.box{
    background:#d8f3dc;
    padding:20px;
    border-radius:15px;
    text-align:center;
}

.box h3{
    margin-bottom:10px;
}

.sustentavel{
    font-size:28px;
    margin-top:20px;
    text-align:center;
    font-weight:bold;
}

footer{
    background:#2d6a4f;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:30px;
}

</style>
</head>

<body>

<header>
    <h1>🌱 EcoPitaya</h1>
    <p>
        Agroforte 2026 - Futuro Sustentável:
        equilíbrio entre produção e meio ambiente
    </p>
</header>

<div class="container">

    <!-- SOBRE -->
    <div class="card">
        <h2>Sobre o Projeto</h2>

        <p>
            Este simulador mostra como uma estufa inteligente
            pode ajudar na produção sustentável de pitaya,
            controlando temperatura, umidade e economia de recursos.
        </p>
    </div>

    <!-- SIMULADOR -->
    <div class="card">

        <h2>Simulador da Estufa</h2>

        <!-- TEMPERATURA -->
        <div class="controle">
            <label>
                🌡 Temperatura:
                <span id="tempValor">25</span>°C
            </label>

            <input
                type="range"
                min="10"
                max="45"
                value="25"
                id="temperatura"
            >
        </div>

        <!-- UMIDADE -->
        <div class="controle">
            <label>
                💧 Umidade:
                <span id="umiValor">60</span>%
            </label>

            <input
                type="range"
                min="20"
                max="100"
                value="60"
                id="umidade"
            >
        </div>

        <!-- ESTUFA -->
        <div class="estufa">

            <div id="pitaya">🌵</div>

            <div class="status" id="status">
                Ambiente ideal para a pitaya!
            </div>

        </div>

        <!-- INDICADORES -->
        <div class="indicadores">

            <div class="box">
                <h3>💧 Água</h3>
                <p id="agua">Baixo consumo</p>
            </div>

            <div class="box">
                <h3>⚡ Energia</h3>
                <p id="energia">Economia alta</p>
            </div>

            <div class="box">
                <h3>🌎 Sustentabilidade</h3>
                <p id="sustentabilidade">Excelente</p>
            </div>

        </div>

        <div class="sustentavel" id="pontuacao">
            🌱 Pontuação Sustentável: 100
        </div>

    </div>

</div>

<footer>
    Projeto desenvolvido para o Concurso Agrinho 2026
</footer>

<script>

const temperatura = document.getElementById("temperatura");
const umidade = document.getElementById("umidade");

const tempValor = document.getElementById("tempValor");
const umiValor = document.getElementById("umiValor");

const pitaya = document.getElementById("pitaya");
const statusTexto = document.getElementById("status");

const agua = document.getElementById("agua");
const energia = document.getElementById("energia");
const sustentabilidade = document.getElementById("sustentabilidade");
const pontuacao = document.getElementById("pontuacao");

function atualizarEstufa(){

    let temp = Number(temperatura.value);
    let umi = Number(umidade.value);

    tempValor.innerText = temp;
    umiValor.innerText = umi;

    let pontos = 100;

    // TEMPERATURA
    if(temp < 18){

        pitaya.innerText = "🥀";
        statusTexto.innerText = "Muito frio para a pitaya.";
        pontos -= 30;

    }

    else if(temp <= 30){

        pitaya.innerText = "🌵";
        statusTexto.innerText = "Ambiente ideal para a pitaya!";

    }

    else{

        pitaya.innerText = "🔥";
        statusTexto.innerText = "Temperatura muito alta!";
        pontos -= 30;

    }

    // UMIDADE
    if(umi < 40){

        agua.innerText = "Pouca água";
        pontos -= 20;

    }

    else if(umi <= 70){

        agua.innerText = "Uso eficiente";

    }

    else{

        agua.innerText = "Excesso de água";
        pontos -= 20;

    }

    // ENERGIA
    if(temp > 35){

        energia.innerText = "Alto gasto energético";
        pontos -= 10;

    }else{

        energia.innerText = "Economia alta";

    }

    // SUSTENTABILIDADE
    if(pontos >= 80){

        sustentabilidade.innerText = "Excelente 🌱";

    }

    else if(pontos >= 50){

        sustentabilidade.innerText = "Boa ✅";

    }

    else{

        sustentabilidade.innerText = "Baixa ❌";

    }

    pontuacao.innerText =
        "🌱 Pontuação Sustentável: " + pontos;

}

temperatura.addEventListener("input", atualizarEstufa);
umidade.addEventListener("input", atualizarEstufa);

atualizarEstufa();

</script>

</body>
</html>